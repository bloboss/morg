# Maintainer: ayrton <ai@blobfish.icu>
pkgname=morg-git
pkgver=r36.af6ae8a
pkgrel=1
pkgdesc='Markdown-idiomatic replacement for Emacs org-mode'
arch=('x86_64' 'aarch64')
url='https://github.com/bloboss/morg'
# README-declared license; the repo does not ship a LICENSE file yet, so
# nothing is installed into /usr/share/licenses until one lands upstream.
license=('MIT')
depends=('gcc-libs')
makedepends=('git' 'rust')
provides=('morg')
conflicts=('morg')
source=("git+https://github.com/bloboss/morg.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/morg"
    # No tags upstream yet: fall back to r<commit-count>.<short-sha> until
    # the first v* tag exists, then git describe takes over.
    (
        set -o pipefail
        git describe --long --tags --abbrev=7 2>/dev/null \
            | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
            || printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    )
}

prepare() {
    cd "$srcdir/morg"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/morg"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

package() {
    cd "$srcdir/morg"
    install -Dm755 target/release/morg "$pkgdir/usr/bin/morg"

    # Shell completions generated by the freshly built binary.
    target/release/morg completions zsh \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_morg"
    target/release/morg completions bash \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/morg"
    target/release/morg completions fish \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/morg.fish"

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
